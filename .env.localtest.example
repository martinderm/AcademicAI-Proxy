ACADEMICAI_PROXY_PORT=11435
ACADEMICAI_PROXY_API_KEY=test-proxy-key-123456

# Offline/local hardening runs do not need real backend credentials.
# For end-to-end AcademicAI runs, fill these three values.
ACADEMICAI_BASE_URL=
ACADEMICAI_CLIENT_ID=
ACADEMICAI_CLIENT_SECRET=

ACADEMICAI_HEALTH_CHECK_BACKEND=false
ACADEMICAI_ENABLE_COST_MONITORING=false
ACADEMICAI_DEBUG_DUMPS=false

# Match the script-test defaults below.
ACADEMICAI_TEST_BASE_URL=http://127.0.0.1:11435
ACADEMICAI_TEST_PROXY_API_KEY=test-proxy-key-123456
ACADEMICAI_TEST_MODEL=gpt-5-mini
